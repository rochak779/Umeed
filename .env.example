# Adapter selection — see src/features/authentication/container.ts
APP_MODE=local
DATA_ADAPTER=local
COMMUNICATION_ADAPTER=mock

# Browser copies of the settings above. Vite only exposes VITE_-prefixed values
# to browser code, so these must mirror DATA_ADAPTER / SUPABASE_URL /
# SUPABASE_ANON_KEY (all safe to expose). Never add a VITE_ copy of the
# service role key.
VITE_DATA_ADAPTER=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — required only when DATA_ADAPTER=supabase or for adapter contract tests
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Session pooler connection string (Dashboard → Connect) — used by `bun run db:migrate`
SUPABASE_DB_URL=

# Required only to run test/infrastructure/supabase/pollDueWorkFunction.contract.test.ts
# against a live, deployed umeed-poll-due-work function — a separate secret from
# SUPABASE_SERVICE_ROLE_KEY above (see supabase/functions/umeed-poll-due-work/index.ts)
UMEED_POLL_DUE_WORK_INVOKE_SECRET=

# Required for Supabase auth redirects — used by createBrowserClient to complete login flows
PUBLIC_APP_URL=http://localhost:3000
