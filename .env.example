# Adapter selection — see src/shared/config.ts and src/features/authentication/container.ts
APP_MODE=local
COMMUNICATION_ADAPTER=mock

# VITE_DATA_ADAPTER decides local vs supabase for both server and browser. It is
# baked in at build time, so rebuild after changing it. (An older server-only
# DATA_ADAPTER, if set, must match it or the app refuses to start.)
VITE_DATA_ADAPTER=local

# Browser copies of SUPABASE_URL / SUPABASE_ANON_KEY below (both safe to expose).
# Never add a VITE_ copy of the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — required only when VITE_DATA_ADAPTER=supabase or for adapter contract tests
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Session pooler connection string (Dashboard → Connect) — used by `bun run db:migrate`
SUPABASE_DB_URL=

# Required only to run test/infrastructure/supabase/pollDueWorkFunction.contract.test.ts
# against a live, deployed umeed-poll-due-work function — a separate secret from
# SUPABASE_SERVICE_ROLE_KEY above (see supabase/functions/umeed-poll-due-work/index.ts)
UMEED_POLL_DUE_WORK_INVOKE_SECRET=

# Required for Supabase auth redirects — used by createBrowserClient to complete login flows
PUBLIC_APP_URL=http://localhost:3000
